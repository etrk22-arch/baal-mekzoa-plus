    // ===== קטגוריות מובילות =====
    function computeCategoryStats() {
      const stats = {};
      providers.forEach(p => {
        if (!stats[p.category]) {
          stats[p.category] = { count: 0, avg: 0, totalRating: 0 };
        }
        stats[p.category].count++;
        stats[p.category].totalRating += p.ratingAvg;
      });
      Object.keys(stats).forEach(cat => {
        stats[cat].avg = (stats[cat].totalRating / stats[cat].count).toFixed(1);
      });
      return stats;
    }

    function renderCategories() {
      const stats = computeCategoryStats();
      categoriesContainer.innerHTML = "";
      Object.keys(stats).forEach(cat => {
        const div = document.createElement("div");
        div.className = "category-card";
        div.innerHTML = `
          <div class="category-name">${cat}</div>
          <div class="category-meta">
            ${stats[cat].count} בעלי מקצוע · ציון ממוצע ${stats[cat].avg}
          </div>
        `;
        div.addEventListener("click", () => {
          document.getElementById("search-category").value = cat;
          searchProviders(cat, "");
        });
        categoriesContainer.appendChild(div);
      });
    }

