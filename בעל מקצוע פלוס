      }
      return list;
    }

    function renderSearchResults(list) {
      resultsList.innerHTML = "";
      if (!list.length) {
        resultsList.innerHTML = `<div style="font-size:0.9rem; color:#777;">לא נמצאו תוצאות מתאימות לחיפוש. נסה לשנות תחום או עיר.</div>`;
        return;
      }

      list.forEach(p => {
        const card = document.createElement("div");
        card.className = "provider-card";
        card.innerHTML = `
          <div class="provider-main">
            <div class="provider-name">${p.name}</div>
            <div class="provider-meta">${p.category} · ${p.city} (${p.area})</div>
            <div class="rating-badge">
              ⭐ ${p.ratingAvg.toFixed(1)}
              <span style="color:#999;">(${p.ratingCount} חוות דעת)</span>
            </div>
            <div class="tags">
              ${p.tags.map(t => `<span class="tag">${t}</span>`).join("")}
            </div>
          </div>
          <div class="provider-actions">
            <div class="price-range">${p.priceRange}</div>
            <button class="btn" data-id="${p.id}">לפרופיל המלא</button>
          </div>
        `;
        card.querySelector("button").addEventListener("click", () => {
          openProviderProfile(p.id);
        });
        resultsList.appendChild(card);
      });
    }

    function searchProviders(categoryValue, cityValue) {
      const list = filterProviders({
        category: categoryValue || document.getElementById("search-category").value,
        city: cityValue || document.getElementById("search-city").value
      });
      renderSearchResults(list);
      showSection("results");

      // לעדכן גם את פילטרי התוצאות
      document.getElementById("filter-category").value =
        categoryValue || document.getElementById("search-category").value;
      document.getElementById("filter-city").value =
        cityValue || document.getElementById("search-city").value;
    }

    // טופס חיפוש ראשי
    document.getElementById("main-search-form").addEventListener("submit", (e) => {
      e.preventDefault();
      searchProviders();
    });

    // כפתור "עדכן תוצאות" בסקשן תוצאות
    document.getElementById("filter-apply").addEventListener("click", () => {
      const category = document.getElementById("filter-category").value;
      const city = document.getElementById("filter-city").value;
      let list = filterProviders({category, city});
      const sortBy = document.getElementById("filter-sort").value;
      if (sortBy === "rating") {
        list.sort((a, b) => b.ratingAvg - a.ratingAvg);
      } else if (sortBy === "reviews") {
        list.sort((a, b) => b.ratingCount - a.ratingCount);
      }
      renderSearchResults(list);
    });

    // ===== פרופיל בעל מקצוע =====
    function openProviderProfile(id) {
      const p = providers.find(x => x.id === id);
      if (!p) return;

      document.getElementById("profile-name").textContent = p.name;
      document.getElementById("profile-meta").textContent =
        `${p.category} · ${p.city} (${p.area})`;

      document.getElementById("profile-rating-main").textContent =
        `⭐ ${p.ratingAvg.toFixed(1)}`;
      document.getElementById("profile-rating-count").textContent =
        `${p.ratingCount} חוות דעת`;

      document.getElementById("profile-breakdown").innerHTML = `
        איכות עבודה: ${p.scores.quality.toFixed(1)}<br>
        מחיר: ${p.scores.price.toFixed(1)}<br>
        עמידה בזמנים: ${p.scores.punctual.toFixed(1)}<br>
        שירות: ${p.scores.service.toFixed(1)}
      `;

      const contacts = document.getElementById("profile-contacts");
      contacts.innerHTML = `
        <button class="btn-outline">☎ התקשר: ${p.phone}</button>
        <button class="btn-outline">💬 וואטסאפ: ${p.whatsapp}</button>
      `;

      const gallery = document.getElementById("profile-gallery");
      gallery.innerHTML = "";
      p.gallery.forEach(item => {
        const div = document.createElement("div");
        div.className = "gallery-item";
        div.textContent = item;
        gallery.appendChild(div);
      });

      const reviewsBox = document.getElementById("profile-reviews");
      reviewsBox.innerHTML = "";
      p.reviews.forEach(r => {
        const div = document.createElement("div");
        div.className = "review";
        div.innerHTML = `
          <div class="review-header">
            <span>${r.reviewerName}</span>
            <span>${r.date} · ⭐ ${r.rating}</span>
          </div>
          <div class="review-body">${r.commentText}</div>
        `;
        reviewsBox.appendChild(div);
      });

      showSection("profile");
    }

    document.getElementById("back-to-results").addEventListener("click", () => {
      showSection("results");
    });

    // ===== טופס בעלי מקצוע (דמו) =====
    document.getElementById("pros-form").addEventListener("submit", (e) => {
      e.preventDefault();
      alert("תודה! הטופס הוא דמו בלבד. במערכת אמיתית הפרטים יישלחו לנציג בעל מקצוע+.");
      e.target.reset();
    });

    // ===== אתחול =====
    function init() {
      renderCategories();
      // תאריך בפוטר
      document.getElementById("year").textContent = new Date().getFullYear();
    }

    init();
  </script>
</body>
</html>
